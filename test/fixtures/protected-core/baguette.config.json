{
  "schema": 1,
  "name": "Protected core fixture",
  "project": "tsconfig.json",
  "entries": ["input.ts"],
  "generatedDir": "build/generated",
  "outDir": "dist",
  "moduleBaseName": "protected-core",
  "abi": {
    "exports": ["score"],
    "tests": [
      { "function": "score", "args": [4], "expected": 14 },
      { "function": "score", "args": [-2], "expected": 4 }
    ]
  },
  "variants": [
    { "name": "protected-core", "threaded": false }
  ],
  "allowedHostImports": [
    { "module": "env", "name": "abort", "kind": "function" },
    { "module": "env", "name": "memory", "kind": "memory" }
  ],
  "bakeLowering": "wide",
  "materialiseInferredTypes": true,
  "asyncLowering": "state-machine"
}
