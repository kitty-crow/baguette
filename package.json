{
  "name": "@kitty-crow/baguette",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "description": "Kernel-independent ahead-of-time TypeScript-to-WebAssembly compiler.",
  "bin": {
    "baguette": "./src/compiler.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit && npm run guards",
    "bake:check": "tsc -p vendor/bake/tsconfig.json --noEmit && tsc -p vendor/bake/tsconfig.core.json --noEmit",
    "test:source-contract": "bun test src/test/source-contract.test.ts",
    "test:wat-modules": "bun test src/test/wat-modules.test.ts",
    "guards": "bash scripts/guards.sh"
  },
  "dependencies": {
    "assemblyscript": "0.28.19",
    "binaryen": "130.0.0-nightly.20260609",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@kitty-crow/code-guards": "git+https://github.com/kitty-crow/code-guards.git#b858b0e0a912b1315fde3203d1e7bcc2ff2d5427"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=22.6.0"
  },
  "author": {
    "name": "Kitty Crow",
    "url": "https://kittycrow.dev"
  },
  "license": "MIT"
}
