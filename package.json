{
  "name": "@kitty-crow/baguette",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "description": "Kernel-independent ahead-of-time TypeScript-to-WebAssembly compiler.",
  "bin": {
    "baguette": "./src/compiler.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit && npm run bake:check && npm run test:obf && npm run test:wide",
    "bake:check": "tsc -p vendor/bake/tsconfig.json --noEmit && tsc -p vendor/bake/tsconfig.core.json --noEmit",
    "test:obf": "node --experimental-strip-types --test test/obf.test.ts",
    "test:protected": "bun src/compiler.ts --config test/fixtures/protected-core/baguette.config.json --skip-determinism-check",
    "test:wide": "node test/wide.mjs"
  },
  "dependencies": {
    "assemblyscript": "0.28.19",
    "binaryen": "130.0.0-nightly.20260609",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=22.6.0"
  },
  "author": {
    "name": "Kitty Crow",
    "url": "https://kittycrow.dev"
  },
  "license": "MIT"
}
